  m_IsActive: 1
--- !u!114 &1378856347
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1378856346}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b161dc913d210b742be3fcc688be1c94, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CoachDirector
  speech: {fileID: 1364142672}
  drone: {fileID: 1364142669}
  focusSeconds: 6
  opening:
  - text: Oh. A visitor. Welcome to Lab 7, where the power is off, the door is locked,
      and I'm the only one who stayed.
    clip: {fileID: 8300000, guid: fa408420f9bccd84cb67a8253117e706, type: 3}
  - text: I'm D-7, the lab's safety drone. Let's get you out before someone asks
      about the incident report.
    clip: {fileID: 8300000, guid: 1184930157a246741bb861207125ce22, type: 3}
  steps:
  - step: {fileID: 1579793001}
    focus: {fileID: 782024373}
    intro:
    - text: 'First problem: no power. Open that fuse box on the wall and look for
        whatever is cooked.'
      clip: {fileID: 0}
    - text: Spares live in the desk drawers. Right next to the snacks everyone here
        denies having.
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 35
      focus: {fileID: 1854555667}
      line:
        text: The fuse box has a door. Doors open. One of the fuses in there is black,
          and black is bad.
        clip: {fileID: 0}
    - afterIdleSeconds: 40
      focus: {fileID: 2287226256700980417}
      line:
        text: The desk against the east wall. Its drawers open when you pull them.
          Revolutionary, I know.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 908960868}
      line:
        text: Top drawer, nearest corner. Same size as the fuse that survived. Size
          matters, with fuses.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 1313490979}
      line:
        text: Fuse in, then the main switch. Up means on. Try to look surprised.
        clip: {fileID: 0}
    solved:
    - text: Lights! Wonderful. Now I can see how messy this place really is.
      clip: {fileID: 8300000, guid: 4834205727cecfa49afe9e06c5d8cf43, type: 3}
  - step: {fileID: 1650114171}
    focus: {fileID: 1682766456}
    intro:
    - text: Power's back, and the lab went straight into lockdown. That terminal
        by the door lists what has to be safe before it lets you out.
      clip: {fileID: 0}
    - text: Fire, air, centrifuge, samples. Any order you like. I'm a safety drone,
        not your supervisor.
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 45
      focus: {fileID: 1682766456}
      line:
        text: Lost? The terminal by the door shows what's still red.
        clip: {fileID: 0}
    solved:
    - text: Checklist complete. Lockdown lifted. Only the door bolts are left.
      clip: {fileID: 0}
  - step: {fileID: 833733892}
    focus: {fileID: 1869065954}
    intro: []
    hints:
    - afterIdleSeconds: 40
      focus: {fileID: 1869065954}
      line:
        text: That bin is still burning. There's an extinguisher on the wall shelf.
          Point and squeeze.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 291716561}
      line:
        text: Keep spraying until the flames are completely gone. Fire is persistent.
          Like me.
        clip: {fileID: 0}
    solved:
    - text: Fire's out. That's one less paragraph in the incident report.
      clip: {fileID: 0}
  - step: {fileID: 1534304437}
    focus: {fileID: 292219113}
    intro: []
    hints:
    - afterIdleSeconds: 40
      focus: {fileID: 292219113}
      line:
        text: The air is contaminated. That valve pushes nitrogen through the vents.
          The needle belongs in the green.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 2051441864}
      line:
        text: Grab the valve by its rim and turn. Small turns, then let the needle
          settle.
        clip: {fileID: 8300000, guid: 754eee4142f5990438b5482e3ee6b87d, type: 3}
    - afterIdleSeconds: 60
      focus: {fileID: 292219113}
      line:
        text: The needle overshoots if you rush. Nudge it into the green and hold
          it there for two seconds.
        clip: {fileID: 8300000, guid: 46b3ff81eb193014aa7137e0f340286c, type: 3}
    - afterIdleSeconds: 60
      focus: {fileID: 2051441864}
      line:
        text: If the alarm goes off, close the valve all the way and start over.
          Gently.
        clip: {fileID: 8300000, guid: c9f5a8623864309438401e7d9b06c594, type: 3}
    solved:
    - text: Air purge running. Breathe normally. Or at all.
      clip: {fileID: 0}
  - step: {fileID: 1028299520}
    focus: {fileID: 1708465805}
    intro: []
    hints:
    - afterIdleSeconds: 40
      focus: {fileID: 1708465805}
      line:
        text: Hear that rattling? The centrifuge is unbalanced. Open the lid and
          have a look.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 1635555107}
      line:
        text: Every tube needs a partner directly across from it. And one tube escaped.
          It's on the bench.
        clip: {fileID: 0}
    solved:
    - text: Perfectly balanced. Unlike whoever loaded it. Not that I saw anything.
      clip: {fileID: 0}
  - step: {fileID: 441431056}
    focus: {fileID: 512044613}
    intro: []
    hints:
    - afterIdleSeconds: 40
      focus: {fileID: 856688602}
      line:
        text: Those sample vials don't belong on the furniture. They go back in cold
          storage.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 512044613}
      line:
        text: Each vial goes on the slot with its color. Then close the door, or
          it doesn't count.
        clip: {fileID: 0}
    solved:
    - text: Samples contained. Nothing is growing. Probably.
      clip: {fileID: 0}
  - step: {fileID: 947789807}
    focus: {fileID: 533677446}
    intro:
    - text: Those bolts are manual. The release takes both hands, so whatever you're
        holding, put it down.
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 30
      focus: {fileID: 533677446}
      line:
        text: Grab the handle with both hands and pull it down toward you. All the
          way.
        clip: {fileID: 8300000, guid: b4edb70a884f013488bb64ccaf02a674, type: 3}
    - afterIdleSeconds: 40
      focus: {fileID: 533677446}
      line:
        text: Let go with one hand and it springs back. Both hands, one smooth pull.
        clip: {fileID: 8300000, guid: 37caf40430dacda40a88f6bb9e9d7468, type: 3}
    solved: []
  ending:
  - text: The door's open! Go on. Enjoy some unfiltered air.
    clip: {fileID: 8300000, guid: bcc6969f7172d314788a0b2747a0ea10, type: 3}
  - text: I'll stay here and write the incident report. Again.
    clip: {fileID: 8300000, guid: 0d9fc360d1a55a24c93c57a669ef39fe, type: 3}
  pressureAlarm:
  - text: And that's the alarm. Close the valve all the way, then try again. Slower.
    clip: {fileID: 8300000, guid: fb4832b382e153540a4dd25b1b151e81, type: 3}
  - text: Turning it faster doesn't make it more stable. Physics filed a complaint.
    clip: {fileID: 8300000, guid: 98515bdb5d620234c8cc84b4caa35925, type: 3}
  - text: Venting. Again. Close it fully and start over, gently this time.
    clip: {fileID: 8300000, guid: 4164966885cc2bf4797c6247518a65e9, type: 3}
  reactionCooldown: 8
