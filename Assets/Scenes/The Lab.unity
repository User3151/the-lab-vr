  m_Name: 05 Coach
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &1378856347
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1378856346}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b161dc913d210b742be3fcc688be1c94, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CoachDirector
  speech: {fileID: 1364142672}
  drone: {fileID: 1364142669}
  focusSeconds: 6
  opening:
  - text: Oh. A visitor. Welcome to Lab 7, where the power is off, the door is locked,
      and I'm the only one who stayed.
    clip: {fileID: 0}
  - text: I'm D-7, the lab's safety drone. Let's get you out before someone asks
      about the incident report.
    clip: {fileID: 0}
  steps:
  - step: {fileID: 1579793001}
    focus: {fileID: 1368077420}
    intro:
    - text: 'First problem: no power. That box on the wall is missing its fuse. Scientists
        keep spares in drawers, right next to the snacks they deny having.'
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 40
      focus: {fileID: 201588659}
      line:
        text: The cabinet by the far wall. Drawers open when you pull them. Revolutionary,
          I know.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 1362914000}
      line:
        text: Middle drawer. I'd open it myself, but I'm a drone. No arms. Tragic.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 1368077420}
      line:
        text: Fuse goes in the fuse box on the wall. Bring it close and let go.
        clip: {fileID: 0}
    solved:
    - text: Lights! Wonderful. Now I can see how messy this place really is.
      clip: {fileID: 0}
  - step: {fileID: 1534304437}
    focus: {fileID: 292219113}
    intro:
    - text: Power's back, but the laser's coolant pressure is all over the place.
        See that gauge? The needle belongs in the green.
      clip: {fileID: 0}
    - text: Turn the red valve. Slowly. It's a pressure system, not a slot machine.
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 40
      focus: {fileID: 2051441864}
      line:
        text: Grab the valve by its rim and turn. Small turns, then let the needle
          settle.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 292219113}
      line:
        text: The needle overshoots if you rush. Nudge it into the green and hold
          it there for two seconds.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 2051441864}
      line:
        text: If the alarm goes off, close the valve all the way and start over.
          Gently.
        clip: {fileID: 0}
    solved:
    - text: Stable! The safety lock just released that maintenance hatch. Behind
        it is the reason we needed coolant.
      clip: {fileID: 0}
  - step: {fileID: 1390315109}
    focus: {fileID: 1238747172}
    intro:
    - text: The calibration laser is live. The door lock runs on an optical relay,
        and its sensor by the door is still dark.
      clip: {fileID: 0}
    - text: Turn the mirrors so the beam hits that sensor straight on. Yes, straight.
        It's picky.
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 45
      focus: {fileID: 1722754670}
      line:
        text: Start with the mirror the beam already hits. Each click turns it a
          little. Watch where the beam goes.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 1416169643}
      line:
        text: Point the first mirror at the second one, then turn the second until
          the beam goes straight at the sensor.
        clip: {fileID: 0}
    - afterIdleSeconds: 60
      focus: {fileID: 696470778}
      line:
        text: And don't stand in the beam. You're opaque. I checked.
        clip: {fileID: 0}
    solved:
    - text: Relay locked on. The door has power. One thing left, and it's heavy.
      clip: {fileID: 0}
  - step: {fileID: 947789807}
    focus: {fileID: 533677446}
    intro:
    - text: That's the manual door release. It takes both hands, so whatever you're
        holding, put it down.
      clip: {fileID: 0}
    hints:
    - afterIdleSeconds: 30
      focus: {fileID: 533677446}
      line:
        text: Grab the handle with both hands and pull it down toward you. All the
          way.
        clip: {fileID: 0}
    - afterIdleSeconds: 40
      focus: {fileID: 533677446}
      line:
        text: Let go with one hand and it springs back. Both hands, one smooth pull.
        clip: {fileID: 0}
    solved: []
  ending:
  - text: The door's open! Go on. Enjoy some unfiltered air.
    clip: {fileID: 0}
  - text: I'll stay here and write the incident report. Again.
    clip: {fileID: 0}
  pressureAlarm:
  - text: And that's the alarm. Close the valve all the way, then try again. Slower.
    clip: {fileID: 0}
  - text: Turning it faster doesn't make it more stable. Physics filed a complaint.
    clip: {fileID: 0}
  - text: Venting. Again. Close it fully and start over, gently this time.
    clip: {fileID: 0}
  reactionCooldown: 8
